tooth <- doolkit::dkpongo$OES
tooth_arc <- doolkit::arc(tooth)
doolkit::dkmap(tooth, tooth_arc, col = "arc")
doolkit::dkmap(tooth, tooth_arc, col = c("red", "blue", "black", "green", "yellow", "brown"), col.levels = 6)
doolkit::dkmap(tooth, tooth_arc, col = c("red", "blue", "black", "green", "yellow", "brown"), col.levels = 5)
doolkit::dkmap(tooth, tooth_arc, col = c("red", "blue", "black", "green", "yellow", "brown"), col.levels = 2)
