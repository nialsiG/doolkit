compute_distance <- function(indA, indB){
if (indB == -1) return(0)
# centroid of triangles indA et indB
x <- doolkit::elev(doolkit::dkpongo$OES)
y <- doolkit::elev(doolkit::dkpongo$EDJ)
return(x - y)
}
