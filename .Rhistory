DTS_Mesh <- doolkit::dkpongo$OES
# Définir les couleurs (voir colors())
colors <- c("white", "orange", "darkorange", "red")
# Créer une palette de couleurs
color_palette <- colorRampPalette(colors)(100)
# Définir les niveaux de couleur
doolkit::dkmap(DTS_Mesh, y = doolkit::arc(DTS_Mesh),
col = color_palette, col.levels = 4,
min.range= 0, max.range= 1,
orient = "occlusal",
main = paste("pARC of ", A),
cex.main = 0.8,
legend.lab = "pARC normalisée")
# Définir les niveaux de couleur
doolkit::dkmap(DTS_Mesh, y = doolkit::arc(DTS_Mesh),
col = color_palette, col.levels = 4,
min.range= 0, max.range= 1,
orient = "occlusal",
cex.main = 0.8,
legend.lab = "pARC normalisée")
