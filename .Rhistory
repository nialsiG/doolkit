distance <- function(indA, indB){
x <- doolkit::dkpongo$OES$vb[, indA]
if (indB == -1) return(0)
else y <- doolkit::dkpongo$EDJ$vb[, indbB]
vec_norm <- sqrt((y[3]-x[3])^2 + (y[2]-x[2])^2 + (y[1]-x[1])^2)
return(vec_norm)
}
compute_distance <- function(indA, indB){
x <- doolkit::dkpongo$OES$vb[, indA]
if (indB == -1) return(0)
else y <- doolkit::dkpongo$EDJ$vb[, indbB]
vec_norm <- sqrt((y[3]-x[3])^2 + (y[2]-x[2])^2 + (y[1]-x[1])^2)
return(vec_norm)
}
