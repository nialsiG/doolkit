mesh_right <- doolkit::dkpongo$OES
Slope <- function(mesh) return(doolkit::slope(mesh))
Rotation <- function(mesh) return(doolkit::orient(mesh))
Angularity <- function(mesh) return(doolkit::angularity(mesh))
fun_list <- list("slope" = Slope, "rotation" = Rotation, "angularity" = Angularity)
tooth_topo_dataframe <- doolkit::tooth_topography(mesh_right, fun_list)
tmpfile <- tcltk::tclvalue(tcltk::tkgetSaveFile())
doolkit::dksave(tooth_topo_dataframe, tmpfile, ".txt")
doolkit::dksave(tooth_topo_dataframe, tmpfile, ".RDS")
doolkit::dksave(tooth_topo_dataframe, tmpfile, ".csv")
doolkit::dksave(tooth_topo_dataframe, tmpfile, ".xslx")
