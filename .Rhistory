compute_distance <- function(indA, indB){
# centroid of triangles indA et indB
nodesA <- doolkit::dkpongo$OES$vb
facesA <- doolkit::dkpongo$OES$it
x <- (nodesA[, facesA[1,]] + nodesA[, facesA[2,]] + nodesA[, facesA[3,]]) / 3
if (indB == -1) return(0)
else {
nodesA <- doolkit::dkpongo$EDJ$vb
facesA <- doolkit::dkpongo$EDJ$it
y <- (nodesA[, facesA[1,]] + nodesA[, facesA[2,]] + nodesA[, facesA[3,]]) / 3
vec_norm <- sqrt((y[3]-x[3])^2 + (y[2]-x[2])^2 + (y[1]-x[1])^2)
return(vec_norm)
}
}
distance <- compute_distance(test2[, 1], test2[, 2])
