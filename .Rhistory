# meshes_files <- choose.files()
meshes_files <- tcltk::tk_choose.files()
Mss <- function(mesh) return(mean(doolkit::slope(mesh)))
Rfi <- function(mesh) return(doolkit::rfi(mesh, method = "Ungar"))
Opcr <- function(mesh) return(doolkit::opcr(mesh)$opcr)
Mang <- function(mesh) return(mean(doolkit::angularity(mesh)))
Dne <- function(mesh) return(doolkit::dne(mesh, total = TRUE))
fun_list <- list("mss" = Mss, "rfi" = Rfi, "opcr" = Opcr, "mangularity" = Mang, "dne" = Dne)
# convex <- function(mesh) return(doolkit::area2d(mesh, method = "convex"))
# concave <- function(mesh) return(doolkit::area2d(mesh, method = "concave"))
#
# fun_list = list("convex" = convex, "concave" = concave)
batch <- doolkit::batch.multi(meshes_files, fun_list, do.parallel = FALSE)
meshes_files <- tcltk::tk_choose.files()
Mss <- function(mesh) return(mean(doolkit::slope(mesh)))
Rfi <- function(mesh) return(doolkit::rfi(mesh, method = "Ungar"))
Opcr <- function(mesh) return(doolkit::opcr(mesh)$opcr)
Mang <- function(mesh) return(mean(doolkit::angularity(mesh)))
Dne <- function(mesh) return(doolkit::dne(mesh, total = TRUE))
fun_list <- list("mss" = Mss, "rfi" = Rfi, "opcr" = Opcr, "mangularity" = Mang, "dne" = Dne)
batch2 <- doolkit::batch.multi(meshes_files, fun_list, filenames = c('01', '02'), do.parallel = TRUE)
View(batch2)
