tmpfile <- tcltk::tclvalue(tcltk::tkgetSaveFile())
meshes_files <- tcltk::tk_choose.files()
Mss <- function(mesh) return(mean(doolkit::slope(mesh)))
Rfi <- function(mesh) return(doolkit::rfi(mesh, method = "Boyer"))
Opcr <- function(mesh) return(doolkit::opcr(mesh)$opcr)
Mang <- function(mesh) return(mean(doolkit::angularity(mesh)))
Dne <- function(mesh) return(doolkit::dne(mesh, total = TRUE))
fun_list <- list("mss" = Mss, "rfi" = Rfi, "opcr" = Opcr, "mangularity" = Mang, "dne" = Dne)
batch <- doolkit::batch.multi(meshes_files, fun_list)
View(batch)
