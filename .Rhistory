library(rgl)
reorder_triangles <- function(mesh, order_vec) {
# Verify object is a mesh3d with triangles
if (!inherits(mesh, "mesh3d") || is.null(mesh$it)) {
stop("Input must be a mesh3d object containing triangles ('it').")
}
# Create a copy of the mesh to modify
new_mesh <- mesh
# Rearrange the columns of the triangle index matrix
new_mesh$it <- mesh$it[, order_vec, drop = FALSE]
# Rearrange triangle normals or colors if present
if (!null(mesh$normals) && ncol(mesh$normals) == ncol(mesh$it)) {
# Per-face normals
new_mesh$normals <- mesh$normals[, order_vec, drop = FALSE]
}
if (!null(mesh$material$color) && length(mesh$material$color) == ncol(mesh$it)) {
# Per-face colors
new_mesh$material$color <- mesh$material$color[order_vec]
}
return(new_mesh)
}
