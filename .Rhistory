mesh_right <- doolkit::dkpongo$OES
Slope <- function(mesh) return(round(doolkit::slope(mesh), 0))
Rotation <- function(mesh) return(doolkit::orient(mesh))
Angularity <- function(mesh) return(doolkit::angularity(mesh))
fun_list <- list("slope" = Slope, "rotation" = Rotation, "angularity" = Angularity)
tooth_topo_dataframe <- doolkit::batch.single(mesh_right, fun_list)
doolkit::dkmap(mesh_right, tooth_topo_dataframe$slope, col = col1)
col1 <- scico::scico(15)
doolkit::dkmap(mesh_right, tooth_topo_dataframe$slope, col = col1)
doolkit::dkmap(mesh_right, tooth_topo_dataframe$slope, col = col1)
compute_distance <- function(indA, indB){
# centroid of triangles indA et indB
x <- doolkit::arc(doolkit::dkpongo$OES)
y <- doolkit::arc(doolkit::dkpongo$EDJ)
results <- vector()
for (i in 1:length(indA)){
results[i] <- x[indA[i]] - y[indB[i]]
if (is.na(y[indB[i]])){
results[i] = -0.1
}
}
return(results)
}
View(compute_distance)
View(compute_distance)
# nearest
test <- doolkit::tridx(doolkit::dkpongo$OES, doolkit::dkpongo$EDJ, method = "nearest")
doolkit::dkmap(doolkit::dkpongo$OES, as.numeric(test[, 2]), col.levels = 1000)
distance <- compute_distance(test[, 1], test[, 2])
doolkit::dkmap(doolkit::dkpongo$OES, distance, col.levels = 1000)
test2 <- doolkit::tridx(doolkit::dkpongo$OES, doolkit::dkpongo$EDJ, method = "normal", direction = -1, epsilon = mean(doolkit::elev(doolkit::dkpongo$OES)) / (Rvcg::nfaces(doolkit::dkmodel$cusp) * 100))
doolkit::dkmap(doolkit::dkpongo$OES, as.numeric(test2[, 2]), col.levels = 1000)
test3 <- doolkit::tridx(doolkit::dkpongo$OES, doolkit::dkpongo$EDJ, method = "ortho", direction = -1, epsilon = mean(doolkit::elev(doolkit::dkpongo$OES)) / Rvcg::nfaces(doolkit::dkpongo$OES))
doolkit::dkmap(doolkit::dkpongo$OES, as.numeric(test3[, 2]), col.levels = 1000)
distance <- compute_distance(test3[, 1], test3[, 2])
doolkit::dkmap(doolkit::dkpongo$OES, distance, col.levels = 1000)
distance <- compute_distance(test2[, 1], test2[, 2])
doolkit::dkmap(doolkit::dkpongo$OES, distance, col.levels = 1000)
doolkit::dkmap(doolkit::dkpongo$OES, as.numeric(test2[, 2]))
View(compute_distance)
compute_distance <- function(indA, indB){
# centroid of triangles indA et indB
x <- doolkit::elev(doolkit::dkpongo$OES)
y <- doolkit::elev(doolkit::dkpongo$EDJ)
results <- vector()
for (i in 1:length(indA)){
results[i] <- x[indA[i]] - y[indB[i]]
if (is.na(y[indB[i]])){
results[i] = -0.1
}
}
return(results)
}
compute_distance <- function(indA, indB){
# centroid of triangles indA et indB
x <- Rvcg::vcgBary(doolkit::dkpongo$OES)
y <- Rvcg::vcgBary(doolkit::dkpongo$EDJ)
results <- vector()
for (i in 1:length(indA)){
results[i] <- x[indA[i]] - y[indB[i]]
if (is.na(y[indB[i]])){
results[i] = -0.1
}
}
return(results)
}
